# (Nothing ignored. manifest.json and manifest.js are generated, but they are
# also part of the deliverable now that marquee.html exists: a static page
# opened from file:// cannot fetch(), so manifest.js has to be sitting on disk
# next to it. Regenerate with `node tools/derive.js --write` and commit the
# result — the `generated` timestamp means every regeneration is a diff, which
# is the price of the page working by double-click.)

# Scratch copies written by the test harnesses and deleted on a clean run.
# Tracked here so a crashed run cannot leave one in a commit.
.smoke-tmp.html
.agree-tmp.html

# Electron shell (step 1). Big and rebuildable; not part of the deliverable.
node_modules/
dist/
.mutant-fd-*.tmp.js

# Look-at-it renders of the sign. marquee.ico IS committed (see below); these
# are only for judging it at size and are regenerated by `node tools/icon.js`.
marquee-*.png

# Windows shortcuts. A .lnk stores an ABSOLUTE path, so one made on this
# machine is useless in any other checkout — and until it is ignored, Tack
# correctly reports it as loose work forever. The Start menu entry is made by
# `tools/shortcut.ps1` instead, which can also remove it again.
*.lnk

# marquee.ico is deliberately NOT ignored, even though tools/icon.js generates
# it. Same reasoning as manifest.js: the Electron window and the Start menu
# shortcut both need it sitting on disk, and there is no build step here to put
# it there. A generated file that something reads at runtime is part of the
# deliverable.
